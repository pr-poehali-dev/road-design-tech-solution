{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Auth required for list",
      "method": "GET",
      "path": "/?action=list",
      "expectedStatus": 401
    },
    {
      "name": "Register validation fails without data",
      "method": "POST",
      "path": "/",
      "body": {"action": "register"},
      "expectedStatus": 400
    }
  ]
}
