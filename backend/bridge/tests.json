{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing partner_id on conversations",
      "method": "GET",
      "path": "/?resource=conversations",
      "expectedStatus": 400
    },
    {
      "name": "Missing client_id on messages",
      "method": "GET",
      "path": "/?resource=messages",
      "expectedStatus": 400
    },
    {
      "name": "Unknown resource POST",
      "method": "POST",
      "path": "/",
      "body": { "resource": "unknown_thing" },
      "expectedStatus": 400
    },
    {
      "name": "Get mailboxes list",
      "method": "GET",
      "path": "/?resource=mailboxes",
      "expectedStatus": 200
    },
    {
      "name": "Folders require partner_id",
      "method": "GET",
      "path": "/?resource=folders",
      "expectedStatus": 400
    },
    {
      "name": "Get folders list",
      "method": "GET",
      "path": "/?resource=folders&partner_id=14",
      "expectedStatus": 200
    },
    {
      "name": "Get signatures list",
      "method": "GET",
      "path": "/?resource=signatures&partner_id=14",
      "expectedStatus": 200
    },
    {
      "name": "Get notifications",
      "method": "GET",
      "path": "/?resource=notifications&partner_id=14",
      "expectedStatus": 200
    },
    {
      "name": "Save folder requires name",
      "method": "POST",
      "path": "/",
      "body": { "resource": "save_folder", "partner_id": 14 },
      "expectedStatus": 400
    },
    {
      "name": "Move message requires ids",
      "method": "POST",
      "path": "/",
      "body": { "resource": "move_message", "partner_id": 14 },
      "expectedStatus": 400
    },
    {
      "name": "Save signature requires name",
      "method": "POST",
      "path": "/",
      "body": { "resource": "save_signature", "partner_id": 14 },
      "expectedStatus": 400
    },
    {
      "name": "Folder messages require ids",
      "method": "GET",
      "path": "/?resource=folder_messages",
      "expectedStatus": 400
    },
    {
      "name": "Get folder messages",
      "method": "GET",
      "path": "/?resource=folder_messages&partner_id=14&folder_id=1",
      "expectedStatus": 200
    },
    {
      "name": "Delete message requires ids",
      "method": "POST",
      "path": "/",
      "body": { "resource": "delete_message", "partner_id": 14 },
      "expectedStatus": 400
    },
    {
      "name": "Delete conversation requires ids",
      "method": "POST",
      "path": "/",
      "body": { "resource": "delete_conversation", "partner_id": 14 },
      "expectedStatus": 400
    },
    {
      "name": "Delete folder requires ids",
      "method": "POST",
      "path": "/",
      "body": { "resource": "delete_folder", "partner_id": 14 },
      "expectedStatus": 400
    },
    {
      "name": "Upload attachment rejects invalid base64",
      "method": "POST",
      "path": "/",
      "body": { "resource": "upload_attachment", "name": "test.txt", "data": "not-valid-base64!!!" },
      "expectedStatus": 400
    }
  ]
}